//.ENV


# Configuração do Servidor
PORT=

# Configuração da Base de Dados
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Segredo para JWT de usuários comuns
JWT_SECRET=
PROVISION_WEBHOOK_SECRET=

# Login de administrador fixo (não depende de tenant/usuário no banco).
# ADMIN_TENANT_ID é opcional: se vazio, resolve automaticamente o único
# tenant existente.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TENANT_ID=
ADMIN_TENANT_NAME=

# Ambiente
NODE_ENV=

# Sincronizacao automatica de schema (Sequelize sync({ alter: true }))
# Por padrao: true fora de producao, false em producao.
DB_AUTO_SYNC=

# Tenant usado pela rota publica de quartos quando nao ha correspondencia
# explicita (opcional).
PUBLIC_ROOMS_TENANT_ID=

# ============================================================
# INTEGRAÇÃO BOOKING.COM
# ============================================================

# OAuth2 Credentials (do Booking Partner Program)
# Obter em: https://partner.booking.com/
# ⚠️ CRÍTICO: Nunca commitar essas variáveis no .env
BOOKING_CLIENT_ID=
BOOKING_CLIENT_SECRET=
BOOKING_HOTEL_ID=

# URL base da API Booking
# Sandbox: https://test-secure-supply-connect.booking.com/
# Production: https://secure-supply-connect.booking.com/
BOOKING_API_BASE_URL=https://secure-supply-connect.booking.com/

# Secret para validar webhooks (gerado no painel Booking)
BOOKING_WEBHOOK_SECRET=

# API Key interna para proteger job de cron de sincronização
# Gerar: openssl rand -base64 32
INTERNAL_API_KEY=
