//.ENV


# Configuração do Servidor
PORT=

# Configuração da Base de Dados
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Segredo para JWT de usuários comuns
JWT_SECRET=
PROVISION_WEBHOOK_SECRET=
# Ambiente
NODE_ENV=

# Sincronizacao automatica de schema (Sequelize sync({ alter: true }))
# Por padrao: true fora de producao, false em producao.
DB_AUTO_SYNC=

# Tenant usado pela rota publica de quartos quando nao ha correspondencia
# explicita (opcional).
PUBLIC_ROOMS_TENANT_ID=

# Mostra a caixa de credenciais de demonstracao na tela de login publica.
# Deixe em branco/false em producao para clientes reais.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=
